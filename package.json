{
  "name": "inkstand",
  "version": "1.0.1",
  "description": "A toolkit for Ink applications",
  "license": "MIT",
  "author": "Josep Boix Requesens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jboix/inkstand.git"
  },
  "bugs": {
    "url": "https://github.com/jboix/inkstand/issues"
  },
  "homepage": "https://github.com/jboix/inkstand#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs/guide",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "ink",
    "terminal",
    "cli",
    "repl",
    "react",
    "headless"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "mkdir -p coverage && node --import tsx --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"src/**/*.test.ts\"",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "demo": "tsx examples/demo.tsx",
    "demo:fullscreen": "tsx examples/demo.tsx --fullscreen",
    "verify": "npm run lint && npm run arch && npm run knip && npm run typecheck && npm test && npm run build",
    "prepare": "husky",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "ink": ">=7.1.0",
    "react": ">=19.0.0"
  },
  "dependencies": {
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "dependency-cruiser": "^18.2.0",
    "husky": "^9.1.7",
    "ink": "^7.1.1",
    "knip": "^6.32.2",
    "react": "^19.2.8",
    "semantic-release": "^25.0.9",
    "tsx": "^4.20.6",
    "typescript": "^6"
  }
}
